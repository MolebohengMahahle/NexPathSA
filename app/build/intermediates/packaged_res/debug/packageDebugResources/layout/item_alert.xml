<?xml version="1.0" encoding="utf-8"?>
<!-- Alert row (.alert in the mock-up); background swaps for unread. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    android:background="@drawable/bg_alert_read"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="13dp">

    <TextView
        android:id="@+id/alertIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_icon"
        android:gravity="center"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alertBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnMarkRead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_mark_btn"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="7dp"
        android:textColor="#53647A"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
