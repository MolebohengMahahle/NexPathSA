<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/pageTitle"
        layout="@layout/layout_page_title" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                style="@style/Card"
                android:padding="18dp">

                <TextView
                    android:id="@+id/textApplyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Complete the application below. The submission is stored with your NexPathSA account on this device." />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="7dp"
                android:text="Full name" />


            <EditText
                android:id="@+id/editAppName"
                style="@style/Input"
                android:hint="Your full name"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />


            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="Email" />


            <EditText
                android:id="@+id/editAppEmail"
                style="@style/Input"
                android:hint="Your email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />


            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="Phone number" />


            <EditText
                android:id="@+id/editAppPhone"
                style="@style/Input"
                android:hint="e.g. 071 234 5678"
                android:importantForAutofill="no"
                android:inputType="phone" />


            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="Cover letter / motivation" />


            <EditText
                android:id="@+id/editAppCover"
                style="@style/Input"
                android:hint="Tell the provider why you are interested and why you should be considered."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:gravity="top"
                android:minLines="6" />


            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="CV / supporting document" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnChooseFile"
                        style="@style/Btn.Outline"
                        android:layout_width="wrap_content"
                        android:minHeight="42dp"
                        android:text="CHOOSE FILE"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/textFileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="No file selected"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/checkConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:buttonTint="@color/teal"
                    android:text="I confirm that the information I provide is accurate and I consent to this application being recorded by NexPathSA."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSubmitApplication"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="SUBMIT APPLICATION" />
            </LinearLayout>
        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav" />
</LinearLayout>
