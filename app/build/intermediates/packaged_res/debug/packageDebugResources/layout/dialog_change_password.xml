<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp">

        <TextView
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create a new strong password. Your new password must meet all five requirements." />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="Current password" />

            <EditText
                android:id="@+id/editOldPassword"
                style="@style/Input"
                android:hint="Current password"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="New password" />

            <EditText
                android:id="@+id/editNewPassword"
                style="@style/Input"
                android:hint="New strong password"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_rules"
                android:columnCount="2"
                android:padding="10dp">

                    <TextView
                        android:id="@+id/newRule1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/muted_light"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/newRule2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/muted_light"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/newRule3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/muted_light"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/newRule4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/muted_light"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/newRule5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/muted_light"
                        android:textSize="12sp" />

            </GridLayout>

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="7dp"
                android:text="Confirm new password" />

            <EditText
                android:id="@+id/editConfirmNewPassword"
                style="@style/Input"
                android:hint="Confirm new password"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/textConfirmNewMsg"
                style="@style/Text.Msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
