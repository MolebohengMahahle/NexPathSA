<?xml version="1.0" encoding="utf-8"?>
<!-- CV builder: the form is built in CvBuilderActivity; the bar at the bottom creates the PDF. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include
        android:id="@+id/pageTitle"
        layout="@layout/layout_page_title" />

    <ScrollView
        android:id="@+id/scrollCv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerCv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnSaveDraft"
            style="@style/Btn.Outline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SAVE DRAFT" />

        <Button
            android:id="@+id/btnCreatePdf"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:gravity="center"
            android:text="CREATE PDF CV" />
    </LinearLayout>
</LinearLayout>
