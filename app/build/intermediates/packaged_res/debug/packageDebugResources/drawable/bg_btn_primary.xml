<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#7FDAD4" /><corners android:radius="10dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/teal_dark" /><corners android:radius="10dp" /></shape></item>
    <item><shape><gradient android:angle="315" android:startColor="@color/teal" android:endColor="@color/teal_dark" /><corners android:radius="10dp" /></shape></item>
</selector>
