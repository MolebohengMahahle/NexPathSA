<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup and device-to-device transfer (Android 12+). Same content as
     backup_rules.xml: the app database and shared preferences, never caches. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="documents/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="documents/" />
    </device-transfer>
</data-extraction-rules>
